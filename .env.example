# Retrieve your GA ID from your GA dashboard
GOOGLE_ANALYTICS_ID=G-XXXXXXX

# Endpoint API Backend Kembar.in (Gunakan localhost:3000 untuk pengujian lokal)
KEMBAR_IN_API_URL=http://localhost:3000/api/participants/register
# Production URL: KEMBAR_IN_API_URL=https://kembar.in/api/participants/register

# Secret trusted-proxy: HARUS sama persis dengan TRUSTED_PROXY_API_KEY di environment
# production kembarin-v2. Kosongkan untuk nonaktifkan (opt-in, tidak wajib untuk go-live).
TRUSTED_PROXY_API_KEY=